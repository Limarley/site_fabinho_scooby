# URL pública do site (usada em metadata, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://fabinhoscooby.com

# Envio de e-mail do formulário de contato (Resend)
# https://resend.com -> API Keys
RESEND_API_KEY=

# Destinatário das mensagens do formulário
CONTACT_TO_EMAIL=contato@fabinhoscooby.com

# Remetente. Precisa ser um domínio verificado no Resend.
# Para testes sem domínio verificado, use: onboarding@resend.dev
CONTACT_FROM_EMAIL="Site Fabinho Scooby <site@fabinhoscooby.com>"
